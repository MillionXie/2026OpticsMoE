# Codex/SSH transfer staging and test caches are disposable. Durable evidence
# must be moved into its owning experiment's artifacts/ directory first.
/.codex_transfer/
/.pytest_cache/
/.tmp_results/

# Git transport packages are indexed before removal and are not source files.
*.bundle
*.tgz
*.tar
*.tar.gz

# The archive directory may contain intentionally retained, non-versioned
# snapshots. Its policy file remains tracked.
/archive/*
!/archive/README.md

# Machine-local research evidence is kept beside its owning experiment without
# being uploaded to GitHub. Each such directory should retain a manifest.
**/artifacts/local_only/
/experiments/qwen_optical_platform_handoff/lab_bundles/

# Machine-local experiment products. Source, configs, tests, and curated small
# manifests remain versioned; bulky/generated outputs stay beside their owner
# on the machine that produced them and are indexed before any cleanup.
/experiments/**/runs/
/experiments/**/logs/
/experiments/**/lab_bundles/
/experiments/**/lab_full_bundles/
/experiments/**/validation_bundles/
/experiments/**/hardware_sessions/
/experiments/**/lab_runs/
/experiments/**/exports/
/experiments/**/reports/
/experiments/**/hardware_exports/
/experiments/**/lab_exports/
/experiments/**/formal_results/
