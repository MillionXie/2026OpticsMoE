#!/bin/sh
# Repository-local guard. This is bypassable, not an OS lock or secret scanner.
root=$(git rev-parse --show-toplevel) || exit 1
guard="$root/maintenance/git_safety/review_git.py"
if [ ! -f "$guard" ]; then
    echo "LightGen Git guard missing from this checkout; refusing commit." >&2
    exit 1
fi
for interpreter in python python3; do
    if command -v "$interpreter" >/dev/null 2>&1 && "$interpreter" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
        exec "$interpreter" "$guard" --repo "$root" --check-staged
    fi
done
echo "LightGen Git guard requires Python >=3.8; staged files were not checked." >&2
exit 1
